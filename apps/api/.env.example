# MongoDB-Verbindung (Atlas: mongodb+srv://<user>:<password>@<cluster>/...)
MONGODB_URI=

# Datenbankname (optional, Standard: inkink)
MONGODB_DB=inkink

# Erlaubte Origins für CORS (komma-separiert; credentials sind aktiviert)
CORS_ORIGINS=http://localhost:3000

# Better Auth / Google OAuth (Auth-Endpoints unter /api/auth/*)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Erlaubte Web-Ursprünge für Auth (komma-separiert) – wird in trustedOrigins übernommen
WEB_ORIGIN=http://localhost:3000

# Nur Produktion: Cookie-Domain für Cross-Subdomain (z.B. .deine-domain.de)
# COOKIE_DOMAIN=

# Auth-Diagnose-Logging der API (Better-Auth-internes Logging): debug | info | warn | error
# (Standard: debug in Entwicklung, warn in Produktion)
# AUTH_LOG_LEVEL=debug